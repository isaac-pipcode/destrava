# ─── Frontend (público, embutido no app — seguro por design) ───────────────
# Painel do Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# ─── Servidor (NUNCA no app) — configure como secrets da Edge Function ──────
# supabase secrets set GEMINI_API_KEY=...
#   GEMINI_API_KEY        Chave do Google Gemini (https://aistudio.google.com/apikey)
#   GEMINI_TEXT_MODEL     (opcional) default: gemini-3-flash-preview
#   GEMINI_IMAGE_MODEL    (opcional) default: gemini-2.5-flash-image
#   AI_DAILY_LIMIT        (opcional) chamadas de IA por usuário/dia. default: 50
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente no ambiente das Edge Functions pelo Supabase.
#
# O OAuth do Google é configurado no painel: Authentication → Providers → Google
# (Client ID/Secret do Google Cloud + redirect URLs web e deep link nativo).
